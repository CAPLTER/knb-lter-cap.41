addCreator <- function(firstInitial, lastName) {
personDetails <- dbGetQuery(prod, paste0("
SELECT
people.person_id,
people.first_name,
people.last_name,
people.email,
people_address.institution,
people_address.department,
orcid.meta_value AS orcid
FROM gios2_production.people
JOIN gios2_production.people_address ON (people.person_id = people_address.person_id)
LEFT JOIN
(
SELECT
people.person_id,
people_values.meta_value
FROM gios2_production.people
JOIN gios2_production.people_values ON (people.person_id = people_values.person_id)
WHERE
people.last_name LIKE '", lastName, "' AND
people.first_name LIKE '", firstInitial, "%' AND
people_values.person_key_id = 24
) orcid ON people.person_id = orcid.person_id
WHERE
people.last_name LIKE '", lastName, "' AND
people.first_name LIKE '", firstInitial, "%';"))
creator_name <- new('individualName',
givenName = personDetails$first_name,
surName = personDetails$last_name)
if(!is.na(personDetails$orcid)) {
creator_orcid <- new('userId',
personDetails$orcid,
directory = 'orcid.org')
}
if(!is.na(personDetails$orcid)) {
newCreator <- new('creator',
individualName = creator_name,
organizationName = personDetails$institution,
electronicMailAddress = personDetails$email,
userId = creator_orcid,
id = paste0(personDetails.first_name, ".", personDetails.last_name))
} else {
newCreator <- new('creator',
individualName = creator_name,
organizationName = personDetails$institution,
electronicMailAddress = personDetails$email,
id = paste0(personDetails.first_name, ".", personDetails.last_name))
}
}
