methods <- set_methods("pitfall_trap_methods/pitfall_trapping_protocol_modified_from_v_sept2016.md")
begindate <- as.character(min(core_arthropods$sample_date))
enddate <- as.character(max(core_arthropods$sample_date))
geographicDescription <- "CAP LTER study area"
coverage <- set_coverage(begin = begindate,
end = enddate,
geographicDescription = geographicDescription,
west = -112.577118210717, east = -111.61479515834,
north = +33.8204250130355, south = +33.3028279145498)
devtools::install_github("EDIorg/taxonomyCleanr")
library(taxonomyCleanr)
my_path <- getwd() # taxonomyCleanr requires a path (to build the taxa_map)
arthropodTaxa <- core_arthropods %>%
mutate(
display_name = str_replace(display_name, "\\(immature\\)", ""),
display_name = str_replace(display_name, "\\(adult\\)", ""),
display_name = str_replace(display_name, "\\(winged\\)", ""),
display_name = str_replace(display_name, "\\(nymph\\)", ""),
display_name = str_replace(display_name, "\\(larvae\\)", ""),
display_name = str_replace(display_name, "\\(imm\\.\\)", ""),
display_name = str_replace(display_name, "\\>10mm", ""),
display_name = str_trim(display_name, side = c("both"))
) %>%
distinct(display_name) %>%
filter(!is.na(display_name))
# create or update map. A taxa_map.csv is the heart of taxonomyCleanr. This
# function will build the taxa_map.csv and put it in the path identified with
# my_path.
create_taxa_map(path = my_path, x = arthropodTaxa, col = "display_name")
arthropodTaxa
# resolve taxa by attempting to match the taxon's In this case, data.source 3 is
# ITIS (which, by the way, is the only authority taxonomyCleanr will allow for
# common names).
# resolve_comm_taxa(path = my_path, data.sources = 3) # in this case, 3 is ITIS
resolve_sci_taxa(path = my_path, data.sources = 3) # in this case, 3 is ITIS
map <- read_csv('taxa_map.csv')
View(map)
?make_taxonomicCoverage
# build the EML taxonomomic coverage
