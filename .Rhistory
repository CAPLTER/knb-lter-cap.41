danChilders <- create_role(firstName = "d", lastName = "childers", roleType = "creator")
creators <- list(nancyGrimm,
danChilders)
stevanEarl <- create_role(firstName = "s", lastName = "earl", roleType = "metadata")
sallyWittlinger <- create_role(firstName = "s", lastName = "wittling", roleType = "metadata")
metadataProvider <- list(stevanEarl,
sallyWittlinger)
markHostetler <- create_role(giosPersonId = 132)
nancyMcintyre <- create_role(giosPersonId = 150)
eyalShochat <- create_role(giosPersonId = 57)
